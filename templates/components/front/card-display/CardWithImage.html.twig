<article{{ attributes.defaults({class: 'display-card display-card--with-image'}) }}>
    <div class="display-card__image-container">
        <img
            class="display-card__image"
            src="{{ this.imageUrl ?? asset('images/project-placeholder.svg') }}"
            alt="{{ this.imageUrl and card.image ? card.image.alt : '' }}"
            loading="lazy"
        >
    </div>

    <div class="display-card__body">
        <h3 class="display-card__title">{{ card.title }}</h3>
        <p class="display-card__text">{{ card.text }}</p>
    </div>

    {% if card.cta and card.cta.label %}
        <twig:Front:Button :cta="card.cta" variant="secondary" class="display-card__cta" />
    {% endif %}
</article>
