<div class="page-builder__block-fields">
    <div class="page-builder__grid page-builder__essentials"><twig:Form:Field :field="data.title.content" label="Titre" /><twig:Form:Field :field="data.text.content" label="Texte" /><twig:Form:Field :field="data.reverse" /></div>
    <details class="page-builder__settings" data-controller="image-source" data-image-source-current-media-value="{{ data.image.mediaId.vars.value|default('') }}"><summary>Image</summary><div class="page-builder__settings-content"><div data-action="change->image-source#change"><twig:Form:Field :field="data.image.source" /></div>{{ form_widget(data.image.mediaId) }}<div data-image-source-target="fileField"><twig:Form:Field :field="data.image.file" /></div><div data-image-source-target="urlField"><twig:Form:Field :field="data.image.url" /></div><div class="page-builder__image-preview" data-image-source-target="previewContainer" hidden><img data-image-source-target="preview" alt="Aperçu de l’image sélectionnée"></div><div class="page-builder__grid"><twig:Form:Field :field="data.image.alt" /><twig:Form:Field :field="data.image.title" /></div></div></details>
    <details class="page-builder__settings" data-controller="link-target"><summary>CTA facultatif</summary><div class="page-builder__settings-content"><twig:Form:Field :field="data.cta.label" /><twig:Form:Field :field="data.cta.target" :widgetAttr="{'data-link-target-target': 'type', 'data-action': 'link-target#toggle'}" /><div data-link-target-target="route"><twig:Form:Field :field="data.cta.routeName" /></div><div data-link-target-target="url"><twig:Form:Field :field="data.cta.href" /></div><twig:Form:KeyValueCollection :field="data.cta.routeParameters" legend="Paramètres de route" /><twig:Form:KeyValueCollection :field="data.cta.attributes" legend="Attributs HTML" /></div></details>
    {% set proof_prototype %}{% include 'dashboard/page/block/_social_proof_form.html.twig' with {item: data.proofs.vars.prototype} only %}{% endset %}
    <fieldset class="page-builder__settings-content" data-controller="form-collection" data-form-collection-index-value="{{ data.proofs|length }}" data-form-collection-prototype-value="{{ proof_prototype|e('html_attr') }}"><legend>Preuves sociales (maximum 2)</legend><ul data-form-collection-target="collectionContainer">{% for item in data.proofs %}{% include 'dashboard/page/block/_social_proof_form.html.twig' with {item: item} only %}{% endfor %}</ul><twig:Admin:Button variant="outline" label="Ajouter une preuve" data-action="form-collection#addCollectionElement" /></fieldset>
    {% set card_prototype %}{% include 'dashboard/page/block/_positioning_card_form.html.twig' with {item: data.cards.vars.prototype} only %}{% endset %}
    <fieldset class="page-builder__settings-content" data-controller="form-collection" data-form-collection-index-value="{{ data.cards|length }}" data-form-collection-prototype-value="{{ card_prototype|e('html_attr') }}"><legend>Cartes de positionnement (3)</legend><ul data-form-collection-target="collectionContainer">{% for item in data.cards %}{% include 'dashboard/page/block/_positioning_card_form.html.twig' with {item: item} only %}{% endfor %}</ul><twig:Admin:Button variant="outline" label="Ajouter une carte" data-action="form-collection#addCollectionElement" /></fieldset>
</div>
