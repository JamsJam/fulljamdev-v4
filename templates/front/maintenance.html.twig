<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>Maintenance | {{ settings.siteTitle }}</title>
        <style>
            * { box-sizing: border-box; }
            body { margin: 0; min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 24px; background: #121019; color: #f5f1ff; font-family: system-ui, sans-serif; }
            main { width: 100%; max-width: 760px; padding: clamp(28px, 6vw, 64px); border: 1px solid #41364f; border-radius: 24px; background: #1c1726; }
            .brand { margin: 0 0 48px; font-weight: 700; }
            .eyebrow { color: #c9afff; letter-spacing: .12em; text-transform: uppercase; font-size: .875rem; }
            h1 { font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.15; margin: 16px 0; }
            .message { color: #c5bed0; line-height: 1.7; white-space: pre-line; overflow-wrap: anywhere; }
            ul { display: flex; flex-wrap: wrap; gap: 12px; list-style: none; padding: 0; margin: 32px 0 0; }
            a { display: inline-block; padding: 12px 20px; border-radius: 10px; background: #c9afff; color: #1c1726; font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
            a:hover { background: #decfff; }
            a:focus-visible { outline: 3px solid white; outline-offset: 4px; }
        </style>
    </head>
    <body>
        <main aria-labelledby="maintenance-title">
            <p class="brand">{{ settings.siteTitle }}</p>
            <p class="eyebrow">Maintenance en cours</p>
            <h1 id="maintenance-title">De retour très bientôt.</h1>
            <p class="message">{{ settings.maintenanceMessage }}</p>
            {% if settings.maintenanceLinks %}
                <nav aria-label="Me retrouver ailleurs">
                    <ul>
                        {% for link in settings.maintenanceLinks %}
                            <li><a href="{{ link.value }}" rel="me">{{ link.name }}</a></li>
                        {% endfor %}
                    </ul>
                </nav>
            {% endif %}
        </main>
    </body>
</html>
