<dialog
    {{ attributes.defaults({class: 'dialog'}) }}
    {{ stimulus_controller('dialog') }}
    {{ stimulus_action('dialog', 'closeFromBackdrop', 'click') }}
>
    <div class="dialog__content">
        <header class="dialog__header">
            <div>
                <h2>{{ title }}</h2>
                {% if description %}<p>{{ description }}</p>{% endif %}
            </div>
            <button
                class="dialog__close"
                type="button"
                aria-label="Fermer"
                title="Fermer"
                {{ stimulus_action('dialog', 'close') }}
            >
                <span aria-hidden="true">×</span>
            </button>
        </header>

        <div class="dialog__body">
            {% block content %}{% endblock %}
        </div>
    </div>
</dialog>
