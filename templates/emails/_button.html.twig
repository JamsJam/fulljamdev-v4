<table role="presentation" cellpadding="0" cellspacing="0" style="margin: 16px 0;">
    <tr><td bgcolor="{{ secondary|default(false) ? '#fbeceb' : '#6750a4' }}" style="border-radius: 8px; text-align: center;">
        <a href="{{ href }}" style="display: inline-block; padding: 14px 24px; border: 1px solid {{ secondary|default(false) ? '#e9b8b4' : '#6750a4' }}; border-radius: 8px; color: {{ secondary|default(false) ? '#8c211b' : '#ffffff' }}; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold; text-decoration: none; mso-padding-alt: 0;">{{ label }}</a>
    </td></tr>
</table>
