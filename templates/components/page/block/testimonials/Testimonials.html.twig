<section class="testimonials" data-block-id="{{ blockId }}"><header><{{ data.title.level.value }}>{{ data.title.content }}</{{ data.title.level.value }}><p>{{ data.text.content }}</p></header><div class="testimonials__grid">{% for testimonial in data.testimonials %}<figure><div aria-label="Note : {{ testimonial.rating }} sur 5">{% for i in 1..5 %}<span aria-hidden="true">{{ i <= testimonial.rating ? '★' : '☆' }}</span>{% endfor %}</div><blockquote>{{ testimonial.comment }}</blockquote></figure>{% endfor %}</div></section>
