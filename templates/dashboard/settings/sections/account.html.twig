<section class="settings__panel" aria-labelledby="settings-account-title">
    <h2 id="settings-account-title">Compte</h2>
    <p>Modifiez les informations du compte administrateur et celles utilisées pour les notifications.</p>

    {{ form_start(user_account_form, {attr: {class: 'settings__form'}}) }}
        {{ form_errors(user_account_form) }}
        <div class="settings__form-grid">
            <twig:Form:Field :field="user_account_form.firstName" class="settings__field" />
            <twig:Form:Field :field="user_account_form.lastName" class="settings__field" />
            <twig:Form:Field :field="user_account_form.email" class="settings__field" />
            <twig:Form:Field :field="user_account_form.phoneNumber" class="settings__field" />
            <twig:Form:Field :field="user_account_form.company" class="settings__field" />
            <twig:Form:Field :field="user_account_form.jobTitle" class="settings__field" />
            <twig:Form:Field :field="user_account_form.newPassword" class="settings__field" />
            <twig:Form:Field :field="user_account_form.currentPassword" class="settings__field" />
        </div>
        {{ form_row(user_account_form.submit, {row_attr: {class: 'settings__form-actions'}}) }}
    {{ form_end(user_account_form) }}
</section>
