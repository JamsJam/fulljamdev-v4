{% extends 'emails/base.html.twig' %}
{% block subject %}À demain !{% endblock %}
{% block preheader %}Notre rendez-vous approche. Voici toutes les informations pour préparer notre échange.{% endblock %}
{% block eyebrow %}Un petit rappel{% endblock %}
{% block heading %}À demain !{% endblock %}
{% block content %}
    <p>Bonjour {{ appointment.contact.firstName }},</p>
    <p>Notre rendez-vous approche. Voici toutes les informations pour préparer notre échange.</p>
    {% include 'emails/reservation/_slot.html.twig' with {appointment: appointment} only %}
    {% if appointment.link %}
        {% include 'emails/_button.html.twig' with {href: appointment.link, label: 'Rejoindre sur Google Meet'} only %}
    {% endif %}
    <p style="font-size: 14px; color: #6c6478;">Un imprévu ? Répondez à cet email pour me prévenir.</p>
{% endblock %}
