{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}
{% block main_attributes %} data-page="login"{% endblock %}

{% block body %}
    <section class="login" aria-labelledby="login-title">
        <form class="login__form" method="post" action="{{ path('app_login') }}">
            <header>
                <p class="login__eyebrow">Administration</p>
                <h1 id="login-title">Connexion</h1>
                <p>Accédez à votre espace d’administration.</p>
            </header>

            {% if error %}
                <p class="login__error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}

            <div class="login__field">
                <label for="username">Adresse email</label>
                <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required autofocus>
            </div>

            <div class="login__field" {{ stimulus_controller('password-visibility') }}>
                <label for="password">Mot de passe</label>
                <div class="login__password">
                    <input id="password" name="_password" type="password" autocomplete="current-password" required {{ stimulus_target('password-visibility', 'input') }}>
                    <button type="button" aria-label="Afficher le mot de passe" aria-pressed="false" {{ stimulus_target('password-visibility', 'button') }} {{ stimulus_action('password-visibility', 'toggle') }}>
                        <svg class="login__visibility-on" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                            <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                            <circle cx="12" cy="12" r="3" />
                        </svg>
                        <svg class="login__visibility-off" aria-hidden="true" viewBox="0 0 24 24" fill="none">
                            <path d="m3 3 18 18M10.6 6.1A9.8 9.8 0 0 1 12 6c6 0 9.5 6 9.5 6a15 15 0 0 1-2.1 2.8M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6a9.6 9.6 0 0 0 3-.5M9.9 9.9a3 3 0 0 0 4.2 4.2" />
                        </svg>
                    </button>
                </div>
            </div>

            <label class="login__remember">
                <input type="checkbox" name="_remember_me">
                <span>Se souvenir de moi pendant 30 jours</span>
            </label>

            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button class="button button--primary" type="submit">Se connecter</button>
        </form>
    </section>
{% endblock %}
