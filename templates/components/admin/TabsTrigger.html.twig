<button
    id="{{ id }}"
    class="tabs__trigger{{ active|default(false) ? ' is-active' : '' }}"
    type="button"
    role="tab"
    aria-selected="{{ active|default(false) ? 'true' : 'false' }}"
    aria-controls="{{ controls }}"
    data-tab="{{ value }}"
    {{ stimulus_target('settings-tabs', 'tab') }}
    {{ stimulus_action('settings-tabs', 'select') }}
>
    {{ label }}
</button>
