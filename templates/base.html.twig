<!DOCTYPE html>
<html lang="fr">
    {% set site = site_settings() %}
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        
        {# ? === title === #}
        <title>{% block title %}Accueil{% endblock %} | {{ site.siteTitle }}</title>
        {# ? === metdescription === #}
        <meta name="description" content="{% block metadescription %}{% endblock %}">
        {# ? === jsonLD === #}
        {# ? === metakeyword === #}
        <meta name="keywords" content="{% block keyword %}{% endblock %}">
        {# ? === opengraph === #}
        {% block openGraph %}{% endblock %}
        
        {# ? === twitter === #}
        {# <meta property="og:title" content="Titre de la page">
        <meta property="og:description" content="Description pour les réseaux sociaux">
        <meta property="og:type" content="website">
        <meta property="og:url" content="https://www.exemple.com/page">
        <meta property="og:image" content="https://www.exemple.com/images/og-image.jpg"> #}
        {# ? === robot === #}
        <meta name="robots" content="{% block robots %}index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1{% endblock %}">
        {# ? === json/ld === #}

        <script type="application/ld+json">{% block jsonLD %}{% endblock %}</script>
        
        {# ? === languages === #}
        <link rel="alternate" hreflang="fr" href="https://fulljamdev.fr/">
        <link rel="alternate" hreflang="x-default" href="https://fulljamdev.fr/">
        {# ? === canonical === #}
        <link rel="canonical" href="{% block canonical %}{% endblock %}" />



        {# ? === favicon === #}
        {% if site.faviconSvgPath %}
            <link rel="icon" type="image/svg+xml" href="{{ asset(site.faviconSvgPath) }}">
        {% endif %}
        {% if site.faviconIcoPath %}
            <link rel="icon" href="{{ asset(site.faviconIcoPath) }}" sizes="any">
        {% endif %}
        {% if site.appleTouchIconPath %}
            <link rel="apple-touch-icon" href="{{ asset(site.appleTouchIconPath) }}">
        {% endif %}
        {% if not site.faviconSvgPath and not site.faviconIcoPath %}
            <link rel="icon" href="{{ asset('favicon/favicon.svg') }}">
        {% endif %}
        {# ? === css global === #}
        {% block stylesheets %}
            {# <link rel="stylesheet" href="{{ asset('styles/app.css') }}"> #}
        {% endblock %}
        {# ? === js === #}
        {% block javascripts %}
            {% block importmap %}
                {{ importmap(['app', 'front']) }}
            {% endblock %}
        {% endblock %}
        <script src="https://analytics.ahrefs.com/analytics.js" data-key="8/+2SjahgSwXty9ZjGAsyQ" async></script>
        <meta name="ahrefs-site-verification" content="78d1c4f2075e84aa1621f088021aa546e2d936c1b8e17791ebf187bafd4130c3">

    </head>
    <body class="front{{ app.current_route == 'app_home' ? ' front--accueil' : '' }}">
        <twig:Front:Header :site="site" />
        <main{% block main_attributes %}{% endblock %}>
            {% block body %}{% endblock %}
        </main>
        <twig:Front:Footer :site="site" />
    </body>
</html>
