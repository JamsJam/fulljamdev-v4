{% set planning = this.planning %}
{% set hasBlockTitle = data.title.content|trim is not empty %}
{% set hasBlockText = data.text.content|trim is not empty %}
{% if planning %}
    {% set bookingFrame = 'planning-booking-' ~ (blockId ?? planning.id) %}
    <section
        class="planning-block"
        data-block-id="{{ blockId }}"
        style="--planning-color: {{ planning.color }}"
    >
        {% if hasBlockTitle or hasBlockText %}
            <header class="planning-block__header">
                {% if hasBlockTitle %}
                    <{{ data.title.level.value }} class="planning-block__title"{{ this.safeAttributes(data.title.attributes)|raw }}>{{ data.title.content }}</{{ data.title.level.value }}>
                {% endif %}
                {% if hasBlockText %}
                    <p class="planning-block__text"{{ this.safeAttributes(data.text.attributes)|raw }}>{{ data.text.content }}</p>
                {% endif %}
            </header>
        {% endif %}

        <turbo-frame
            id="{{ bookingFrame }}"
            src="{{ path('app_front_planning_appointment', {slug: planning.slug, _frame: bookingFrame, _heading: hasBlockTitle ? 'h2' : 'h1'}) }}"
            loading="lazy"
            class="planning-block__booking"
        >
            <div class="planning-block__loading" role="status" aria-label="Chargement du planning">
                <span class="planning-block__spinner" aria-hidden="true"></span>
            </div>
        </turbo-frame>
    </section>
{% else %}
    <section class="planning-block" data-block-id="{{ blockId }}">
        {% if hasBlockTitle or hasBlockText %}
            <header class="planning-block__header">
                {% if hasBlockTitle %}
                    <{{ data.title.level.value }} class="planning-block__title"{{ this.safeAttributes(data.title.attributes)|raw }}>{{ data.title.content }}</{{ data.title.level.value }}>
                {% endif %}
                {% if hasBlockText %}
                    <p class="planning-block__text"{{ this.safeAttributes(data.text.attributes)|raw }}>{{ data.text.content }}</p>
                {% endif %}
            </header>
        {% endif %}
        <p class="planning-block__loading">La prise de rendez-vous est momentanément indisponible. Vous pouvez utiliser les autres moyens de contact proposés sur cette page.</p>
    </section>
{% endif %}
