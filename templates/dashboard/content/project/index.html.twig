{% extends 'adminBase.html.twig' %}{% block title %}Projets{% endblock %}{% block body %}
<section class="content-manager" aria-labelledby="projects-title"><header class="content-manager__header"><div><h1 id="projects-title">Projets</h1><p>Gérez les réalisations web et leur mise en avant.</p></div><twig:Admin:Button icon="material-symbols:add-rounded" label="Ajouter un projet" href="{{ path('app_dashboard_project_new') }}" /></header>
{% if projects is empty %}<p class="content-manager__empty">Aucun projet enregistré.</p>{% else %}<div class="content-manager__table-wrapper"><table class="content-manager__table"><thead><tr><th>Projet</th><th>Slug</th><th>Statut</th><th>Mis en avant</th><th>Actions</th></tr></thead><tbody>{% for project in projects %}<tr><th scope="row">{{ project.title }}</th><td>{{ project.slug }}</td><td>{{ project.status == 'published' ? 'Publié' : 'Brouillon' }}</td><td>{{ project.featured ? 'Oui' : 'Non' }}</td><td><div class="content-manager__actions"><twig:Admin:Button variant="outline" label="Modifier" href="{{ path('app_dashboard_project_edit', {id: project.id}) }}" /><form method="post" action="{{ path('app_dashboard_project_delete', {id: project.id}) }}" onsubmit="return confirm('Supprimer ce projet ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_project_' ~ project.id) }}"><twig:Admin:Button type="submit" variant="destructive" label="Supprimer" /></form></div></td></tr>{% endfor %}</tbody></table></div>{% endif %}</section>
{% endblock %}
