{% extends 'emails/base.html.twig' %}
{% block subject %}Votre demande de rendez-vous a bien été reçue{% endblock %}
{% block preheader %}Votre créneau est demandé. Un email vous informera dès sa confirmation.{% endblock %}
{% block eyebrow %}Demande reçue{% endblock %}
{% block heading %}Merci, votre demande est bien arrivée.{% endblock %}
{% block content %}
    <p>Bonjour {{ appointment.contact.firstName }},</p>
    <p>Votre demande pour « {{ appointment.planning.title }} » a bien été enregistrée. Je reviens vers vous dès qu’elle a été traitée.</p>
    {% include 'emails/reservation/_slot.html.twig' with {appointment: appointment} only %}
    <p style="padding: 16px; background-color: #fff8e6; color: #715318; border-radius: 8px; font-size: 14px;">Ce rendez-vous est en attente de validation. Vous recevrez un nouvel email avec les informations de connexion une fois confirmé.</p>
{% endblock %}
