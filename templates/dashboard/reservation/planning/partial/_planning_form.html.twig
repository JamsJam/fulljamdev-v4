<div id="planning-dialog-content">
    {% if not editing|default(false) %}
    <twig:Admin:Stepper
        :steps="['Créer le planning', 'Modifier les disponibilités']"
        :activeStep="1"
        label="Étapes de création du planning"
    />
    {% endif %}

    {{ form_start(form, {
        attr: {
            class: 'planning-form',
            'data-turbo-stream': editing|default(false) ? 'false' : 'true'
        }
    }) }}
        {{ form_errors(form) }}

        <div class="planning-form__fields">
            <twig:Form:Field :field="form.title" />
            <twig:Form:Field :field="form.description" />
            <twig:Form:Field :field="form.isActive" />
            <twig:Form:Field :field="form.isOnline" />

            <div class="planning-form__row">
                <twig:Admin:Slider :field="form.duration" :min="5" :max="60" :step="5" suffix=" min" />
                <twig:Admin:Slider :field="form.gap" :min="10" :max="40" :step="5" suffix=" min" />
            </div>

            <div
                class="planning-form__row planning-form__row--compact planning-color-check"
                data-controller="planning-color-availability"
                data-planning-color-availability-url-value="{{ path('app_dashboard_reservation_planning_check_color', editing|default(false) ? {id: planning.id} : {}) }}"
                data-planning-color-availability-loading-value="false"
            >
                <twig:Form:Field :field="form.color" />
                <div class="planning-color-check__feedback" role="status" aria-live="polite">
                    <span
                        class="planning-color-check__spinner"
                        data-planning-color-availability-target="spinner"
                        aria-hidden="true"
                        hidden
                    ></span>
                    <span
                        id="planning-color-availability-message"
                        class="planning-color-check__message"
                        data-planning-color-availability-target="message"
                        hidden
                    ></span>
                </div>
            </div>
        </div>

        <div class="planning-form__actions">
            {% if editing|default(false) %}
                <twig:Admin:Button variant="outline" label="Annuler" href="{{ path('app_dashboard_reservation_plannings') }}" />
            {% else %}
                <twig:Admin:Button variant="outline" label="Annuler" data-action="dialog#close" />
            {% endif %}
            <twig:Admin:Button variant="primary" type="submit" label="{{ editing|default(false) ? 'Enregistrer les modifications' : 'Continuer' }}" />
        </div>
    {{ form_end(form) }}
</div>
