

<footer class="footer">
    <div class="footer__container">
        <div class="footer__brand">
            <a class="footer__logo" href="{{ path('app_home') }}" aria-label="FullJam Dev — retour à l'accueil">
                <img
                    src="{{ asset(site.logoPath ?? 'images/logos/logo-320.png') }}"
                    width="320"
                    height="49"
                    alt="{{ site.siteTitle }}"
                    loading="lazy"
                >
            </a>
            <p class="footer__description">
                Développement web et SEO pour des solutions performantes, accessibles et durables.
            </p>
        </div>

        <nav class="footer__navigation" aria-label="Navigation principale du pied de page">
            <p class="footer__title">Navigation</p>
            <ul class="footer__links">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('app_front_page', {path: 'about'}) }}">À propos</a></li>
                <li><a href="{{ path('app_front_projects') }}">Projets</a></li>
                <li><a href="{{ path('app_front_blog') }}">Blog</a></li>
                <li><a href="{{ path('app_front_page', {path: 'contact'}) }}">Contact</a></li>
            </ul>
        </nav>

        <nav class="footer__navigation" aria-label="Accès à l’espace d’administration">
            <p class="footer__title">Espace</p>
            <ul class="footer__links">
                {% if is_granted('ROLE_ADMIN') %}
                    <li><a href="{{ path('app_dashboard') }}">Dashboard</a></li>
                {% else %}
                    <li><a href="{{ path('app_login') }}">Connexion</a></li>
                {% endif %}
            </ul>
        </nav>

        <div class="footer__contact">
            <p class="footer__title">Me retrouver</p>
            <a class="footer__email" href="mailto:contact@fulljamdev.fr">contact@fulljamdev.fr</a>
            <ul class="footer__socials" aria-label="Réseaux sociaux">
                <li>
                    <a href="https://github.com/JamsJam" target="_blank" rel="noopener noreferrer nofollow">GitHub</a>
                </li>
                <li>
                    <a href="https://www.malt.fr/profile/jeremyantoine" target="_blank" rel="noopener noreferrer nofollow">Malt</a>
                </li>
                <li>
                    <a href="https://www.linkedin.com/in/jeremy-antoine-dwwm/" target="_blank" rel="noopener noreferrer nofollow">LinkedIn</a>
                </li>
            </ul>
        </div>
    </div>

    <div class="footer__bottom">
        <p>&copy; {{ 'now'|date('Y') }} {{ site.siteTitle }}. Tous droits réservés.</p>
    </div>
</footer>
