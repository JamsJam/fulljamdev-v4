<section class="cta-glow" data-block-id="{{ blockId }}">
    <span class="cta-glow__spot cta-glow__spot--left" aria-hidden="true"></span>
    <span class="cta-glow__spot cta-glow__spot--top" aria-hidden="true"></span>
    <span class="cta-glow__spot cta-glow__spot--right" aria-hidden="true"></span>

    <div class="cta-glow__content">
        <{{ data.title.level.value }} class="cta-glow__title"{{ this.safeAttributes(data.title.attributes)|raw }}>{{ data.title.content }}</{{ data.title.level.value }}>
        <p class="cta-glow__text"{{ this.safeAttributes(data.text.attributes)|raw }}>{{ data.text.content }}</p>
        {% if data.cta.label %}
            <twig:Front:Button :cta="data.cta" variant="cta" class="cta-glow__button" />
        {% endif %}
    </div>
</section>
