<section class="pricing" data-block-id="{{ blockId }}"><header><{{ data.title.level.value }}>{{ data.title.content }}</{{ data.title.level.value }}><p>{{ data.text.content }}</p></header><div class="pricing__grid">{% for card in data.cards %}<article class="pricing__card{{ card.featured ? ' pricing__card--featured' }}"{% if card.featured %} aria-label="Offre recommandée : {{ card.title }}"{% endif %}>{% if card.featured %}<p class="pricing__badge">Le plus choisi</p>{% endif %}<h3>{{ card.title }}</h3><p>{{ card.description }}</p><p class="pricing__price">{{ this.formatPrice(card.price) }} <small>{{ card.period.label }}</small></p>{% if card.features %}<ul>{% for feature in card.features %}<li>{{ feature }}</li>{% endfor %}</ul>{% endif %}</article>{% endfor %}</div></section>
