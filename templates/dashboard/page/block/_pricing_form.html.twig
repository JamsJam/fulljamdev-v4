<div class="page-builder__block-fields"><div class="page-builder__grid page-builder__essentials"><twig:Form:Field :field="data.title.content" label="Titre" /><twig:Form:Field :field="data.text.content" label="Texte" /></div>{% set prototype %}{% include 'dashboard/page/block/_pricing_card_form.html.twig' with {item: data.cards.vars.prototype} only %}{% endset %}<fieldset class="page-builder__settings-content" data-controller="form-collection" data-form-collection-index-value="{{ data.cards|length }}" data-form-collection-prototype-value="{{ prototype|e('html_attr') }}"><legend>Offres</legend><ul data-form-collection-target="collectionContainer">{% for item in data.cards %}{% include 'dashboard/page/block/_pricing_card_form.html.twig' with {item: item} only %}{% endfor %}</ul><twig:Admin:Button variant="outline" label="Ajouter une offre" data-action="form-collection#addCollectionElement" /></fieldset></div>
