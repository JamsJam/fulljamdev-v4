{% set missing = status_code == 404 %}
{% set unavailable = status_code >= 500 %}
{% set heading = missing ? 'Cette page est introuvable.' : (unavailable ? 'Le site est momentanément indisponible.' : 'Cette page est inaccessible.') %}
<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="robots" content="noindex, nofollow">
        <title>{{ heading }} | FullJamDev</title>
        <style>
            * { box-sizing: border-box; }
            body { margin: 0; min-height: 100vh; min-height: 100svh; display: grid; place-items: center; padding: 24px; background: #121019; color: #f5f1ff; font-family: system-ui, sans-serif; }
            main { width: 100%; max-width: 720px; padding: clamp(28px, 6vw, 64px); border: 1px solid #41364f; border-radius: 24px; background: #1c1726; }
            .brand { margin: 0 0 48px; font-weight: 700; letter-spacing: .04em; }
            .status { color: #c9afff; font-size: .875rem; letter-spacing: .12em; text-transform: uppercase; }
            h1 { margin: 16px 0; font-size: clamp(2rem, 5vw, 3.25rem); line-height: 1.12; overflow-wrap: anywhere; }
            .description { max-width: 52ch; color: #c5bed0; line-height: 1.7; }
            a { display: inline-block; margin-top: 24px; padding: 14px 22px; border-radius: 10px; background: #c9afff; color: #1c1726; font-weight: 700; text-decoration: none; }
            a:hover { background: #decfff; }
            a:focus-visible { outline: 3px solid #fff; outline-offset: 5px; }
        </style>
    </head>
    <body>
        <main aria-labelledby="error-title">
            <p class="brand">FullJamDev</p>
            <p class="status">Erreur {{ status_code }}</p>
            <h1 id="error-title">{{ heading }}</h1>
            <p class="description">
                {% if missing %}
                    La page que vous cherchez n’existe pas ou n’est plus disponible. Vérifiez l’adresse ou revenez un peu plus tard.
                {% elseif unavailable %}
                    Une interruption temporaire empêche l’affichage de cette page. Merci de réessayer dans quelques instants.
                {% else %}
                    Votre demande ne peut pas aboutir. Vous pouvez revenir à l’accueil pour poursuivre votre visite.
                {% endif %}
            </p>
            <a href="{{ path('app_home') }}">Retour à l’accueil</a>
        </main>
    </body>
</html>
