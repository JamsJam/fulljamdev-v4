<section{% if anchorId %} id="{{ anchorId }}"{% endif %} class="pricing" data-block-id="{{ blockId }}" aria-labelledby="pricing-title-{{ blockId|default('preview') }}">
    <header>
        <{{ data.title.level.value }} id="pricing-title-{{ blockId|default('preview') }}">{{ data.title.content }}</{{ data.title.level.value }}>
        <p>{{ data.text.content }}</p>
    </header>

    <div class="pricing__grid">
        {% for card in data.cards %}
            <article class="pricing__card{{ card.featured ? ' pricing__card--featured' }}"{% if card.featured %} aria-label="Offre recommandée : {{ card.title }}"{% endif %}>
                {% if card.featured %}<p class="pricing__badge">Le plus choisi</p>{% endif %}
                <h3>{{ card.title }}</h3>
                <p>{{ card.description }}</p>
                <p class="pricing__price">
                    {% if card.showStartingAt %}<span class="pricing__price-prefix">À partir de</span>{% endif %}
                    {{ this.formatPrice(card.price) }}
                    <small>{{ card.period.label }}</small>
                </p>
                {% if card.features %}
                    <ul class="pricing__features">{% for feature in card.features|slice(0, 3) %}<li>{{ feature }}</li>{% endfor %}</ul>
                    {% if card.features|length > 3 %}
                        <details class="pricing__details">
                            <summary>Voir tout ce qui est inclus</summary>
                            <ul class="pricing__features">{% for feature in card.features|slice(3) %}<li>{{ feature }}</li>{% endfor %}</ul>
                        </details>
                    {% endif %}
                {% endif %}
                {% if card.cta and card.cta.label %}
                    <twig:Front:Button :cta="card.cta" variant="primary" class="pricing__cta" />
                {% endif %}
            </article>
        {% endfor %}
    </div>
</section>
