{% for label, messages in flashes %}
	{% for message in messages %}


		<div class="flash__container" {{stimulus_controller("flash")}} role="status" aria-live="polite">
			<div class="flash flash__{{ label }}" {{stimulus_target("flash","flash")}}>

				<p>
					{{ message }}
				</p>
			</div>
		</div>
	{% endfor %}
{% endfor %}
