<section class="settings__panel" aria-labelledby="settings-account-title">
    <h2 id="settings-account-title">Compte</h2>
    <p>Ces informations identifient le propriétaire du compte et sont utilisées pour les notifications de rendez-vous.</p>

    {{ form_start(account_form, {attr: {class: 'settings__form'}}) }}
        {{ form_errors(account_form) }}
        <div class="settings__form-grid">
            <twig:Form:Field :field="account_form.firstName" class="settings__field" />
            <twig:Form:Field :field="account_form.lastName" class="settings__field" />
            <twig:Form:Field :field="account_form.email" class="settings__field" />
            <twig:Form:Field :field="account_form.phoneNumber" class="settings__field" />
            <twig:Form:Field :field="account_form.company" class="settings__field" />
            <twig:Form:Field :field="account_form.jobTitle" class="settings__field" />
        </div>
        {{ form_row(account_form.submit, {row_attr: {class: 'settings__form-actions'}}) }}
    {{ form_end(account_form) }}
</section>
