<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin: 24px 0; background-color: #f5f2fa; border-left: 4px solid #6750a4; border-radius: 8px;">
    <tr><td style="padding: 20px; color: #292333; font-family: Arial, Helvetica, sans-serif; line-height: 1.6;">
        <p style="margin: 0 0 6px; font-size: 16px; font-weight: bold;">{{ appointment.startAt|format_datetime(pattern: 'EEEE d MMMM y', locale: 'fr', timezone: appointment.timezone)|capitalize }}</p>
        <p style="margin: 0; font-size: 22px; font-weight: bold;">{{ appointment.startAt|format_datetime(pattern: 'HH:mm', timezone: appointment.timezone) }} – {{ appointment.endAt|format_datetime(pattern: 'HH:mm', timezone: appointment.timezone) }}</p>
        <p style="margin: 4px 0 0; color: #6c6478; font-size: 12px;">Fuseau horaire : {{ appointment.timezone }}</p>
        <p style="margin: 12px 0 0; font-size: 14px;">{{ appointment.title }}</p>
    </td></tr>
</table>
