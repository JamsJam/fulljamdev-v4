{% extends 'emails/base.html.twig' %}
{% block subject %}{{ notification.subject }}{% endblock %}
{% block preheader %}{{ notification.message }}{% endblock %}
{% block heading %}{{ notification.heading }}{% endblock %}
{% block content %}
    <p>Bonjour {{ appointment.contactFirstName }},</p>
    <p>{{ notification.message }}</p>
    {% include 'emails/reservation/_slot.html.twig' with {appointment: appointment} only %}
    {% if notification.action == 'join' and appointment.link %}
        {% include 'emails/_button.html.twig' with {href: appointment.link, label: 'Rejoindre sur Google Meet'} only %}
        <p style="font-size: 12px; color: #6c6478;">Conservez cet email pour retrouver votre lien le jour du rendez-vous.</p>
    {% elseif notification.action == 'book' and appointment.planningSlug %}
        {% include 'emails/_button.html.twig' with {href: url('app_front_planning_appointment', {slug: appointment.planningSlug}), label: 'Choisir un nouveau créneau'} only %}
    {% endif %}
    {% if appointment.summary %}
        <h2 style="font-size: 20px; margin-top: 28px;">Le compte rendu de notre échange</h2>
        <div style="padding: 20px; border: 1px solid #e8e1ef; border-radius: 8px;">{{ appointment.summary|sanitize_html }}</div>
    {% endif %}
{% endblock %}
