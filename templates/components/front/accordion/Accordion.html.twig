<div{{ attributes.defaults({class: 'accordion', 'data-controller': 'accordion'}) }}>
    {% for item in items %}
        {% set trigger_id = name ~ '-trigger-' ~ loop.index %}
        {% set panel_id = name ~ '-panel-' ~ loop.index %}
        <div class="accordion__item" data-accordion-target="item">
            <button
                class="accordion__trigger"
                id="{{ trigger_id }}"
                type="button"
                aria-expanded="false"
                aria-controls="{{ panel_id }}"
                data-action="accordion#toggle"
            >
                <span>{{ item.question }}</span>
                <span class="accordion__icon" aria-hidden="true"></span>
            </button>
            <div
                class="accordion__content"
                id="{{ panel_id }}"
                role="region"
                aria-labelledby="{{ trigger_id }}"
                aria-hidden="true"
                data-accordion-target="panel"
            >
                <div class="accordion__content-inner"><p>{{ item.answer }}</p></div>
            </div>
        </div>
    {% endfor %}
</div>
