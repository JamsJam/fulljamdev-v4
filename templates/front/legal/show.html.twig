{% extends 'base.html.twig' %}

{% block title %}{{ legal_page.title }}{% endblock %}
{% block robots %}noindex, nofollow{% endblock %}
{% block main_attributes %} data-page="legal"{% endblock %}

{% block body %}
    <article class="legal-page" aria-labelledby="legal-page-title">
        <h1 id="legal-page-title">{{ legal_page.title }}</h1>
        <div class="legal-page__content">{{ legal_page.content|raw }}</div>
    </article>
{% endblock %}
