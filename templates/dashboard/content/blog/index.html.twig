{% extends 'adminBase.html.twig' %}{% block title %}Blog{% endblock %}{% block body %}
<section class="content-manager" aria-labelledby="blog-title"><header class="content-manager__header"><div><h1 id="blog-title">Blog</h1><p>Gérez les articles et leurs catégories.</p></div><div class="content-manager__actions"><twig:Admin:Button variant="outline" label="Ajouter une catégorie" href="{{ path('app_dashboard_blog_category_new') }}" /><twig:Admin:Button icon="material-symbols:add-rounded" label="Ajouter un article" href="{{ path('app_dashboard_blog_article_new') }}" /></div></header>
<h2>Articles</h2>{% if articles is empty %}<p class="content-manager__empty">Aucun article enregistré.</p>{% else %}<div class="content-manager__table-wrapper"><table class="content-manager__table"><thead><tr><th>Article</th><th>Catégorie</th><th>Statut</th><th>Publication</th><th>Actions</th></tr></thead><tbody>{% for article in articles %}<tr><th scope="row">{{ article.title }}</th><td>{{ article.category ? article.category.name : 'Sans catégorie' }}</td><td>{{ article.status == 'published' ? 'Publié' : 'Brouillon' }}</td><td>{{ article.publishedAt ? article.publishedAt|date('d/m/Y H:i') : '—' }}</td><td><div class="content-manager__actions"><twig:Admin:Button variant="outline" label="Modifier" href="{{ path('app_dashboard_blog_article_edit', {id: article.id}) }}" /><form method="post" action="{{ path('app_dashboard_blog_article_delete', {id: article.id}) }}" onsubmit="return confirm('Supprimer cet article ?')"><input type="hidden" name="_token" value="{{ csrf_token('delete_article_' ~ article.id) }}"><twig:Admin:Button type="submit" variant="destructive" label="Supprimer" /></form></div></td></tr>{% endfor %}</tbody></table></div>{% endif %}
<div class="content-manager__subsection"><h2>Catégories</h2>{% if categories is empty %}<p class="content-manager__empty">Aucune catégorie enregistrée.</p>{% else %}<div class="content-manager__table-wrapper"><table class="content-manager__table"><thead><tr><th>Catégorie</th><th>Slug</th><th>Articles</th><th>Actions</th></tr></thead><tbody>{% for category in categories %}<tr><th scope="row">{{ category.name }}</th><td>{{ category.slug }}</td><td>{{ category.articles|length }}</td><td><div class="content-manager__actions"><twig:Admin:Button variant="outline" label="Modifier" href="{{ path('app_dashboard_blog_category_edit', {id: category.id}) }}" /><form method="post" action="{{ path('app_dashboard_blog_category_delete', {id: category.id}) }}" onsubmit="return confirm('Supprimer cette catégorie ? Les articles seront conservés.')"><input type="hidden" name="_token" value="{{ csrf_token('delete_category_' ~ category.id) }}"><twig:Admin:Button type="submit" variant="destructive" label="Supprimer" /></form></div></td></tr>{% endfor %}</tbody></table></div>{% endif %}</div></section>
{% endblock %}
