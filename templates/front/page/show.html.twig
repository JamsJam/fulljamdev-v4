{% extends 'base.html.twig' %}

{% block title %}{{ page.seo.title ?: page.title }}{% endblock %}
{% block metadescription %}{{ page.seo.description }}{% endblock %}
{% block canonical %}{{ page.seo.canonicalUrl }}{% endblock %}
{% block robots %}{{ page.seo.noIndex ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1' }}{% endblock %}
{% block main_attributes %} data-page="{{ page.path ?: 'accueil' }}"{% endblock %}

{% block body %}
    {% for block in page.blocks %}
        <twig:Page:BlockRenderer :block="block" />
    {% endfor %}
{% endblock %}
