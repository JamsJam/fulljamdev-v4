

<header class="header">
    <div class="header__top">
        <ul class="header__socials" aria-label="Réseaux sociaux">
            <li><a href="https://github.com/JamsJam" target="_blank" rel="noopener noreferrer nofollow" aria-label="GitHub"><img src="{{ asset('icons/github_icn.svg') }}" width="17" height="16" alt=""></a></li>
            <li><a href="https://www.malt.fr/profile/jeremyantoine" target="_blank" rel="noopener noreferrer nofollow" aria-label="Malt"><img src="{{ asset('icons/malt_icn.svg') }}" width="17" height="16" alt=""></a></li>
            <li><a href="https://www.linkedin.com/in/jeremy-antoine-dwwm/" target="_blank" rel="noopener noreferrer nofollow" aria-label="LinkedIn"><img src="{{ asset('icons/linkedin_icn.svg') }}" width="17" height="16" alt=""></a></li>
        </ul>

        <a class="header__brand" href="{{ path('app_home') }}" aria-label="FullJam Dev — retour à l'accueil">
            <img src="{{ asset(site.logoPath ?? 'favicon/favicon.svg') }}" width="46" height="45" alt="">
            <span>{{ site.siteTitle }}</span>
        </a>

        <a class="header__cta" href="{{ path('app_front_page', {path: 'contact'}) }}">Prenez rendez-vous</a>
    </div>

    <nav class="header__navigation" aria-label="Navigation principale">
        <ul>
            <li><a href="{{ path('app_home') }}"{% if app.current_route == 'app_home' %} aria-current="page"{% endif %}>Accueil</a></li>
            <li><a href="{{ path('app_front_page', {path: 'about'}) }}"{% if app.request and app.request.attributes.get('path') == 'about' %} aria-current="page"{% endif %}>À propos</a></li>
            <li><a href="{{ path('app_front_page', {path: 'blog'}) }}"{% if app.request and app.request.attributes.get('path') == 'blog' %} aria-current="page"{% endif %}>Blog</a></li>
            <li><a href="{{ path('app_front_page', {path: 'contact'}) }}"{% if app.request and app.request.attributes.get('path') == 'contact' %} aria-current="page"{% endif %}>Contact</a></li>
        </ul>
    </nav>
</header>
