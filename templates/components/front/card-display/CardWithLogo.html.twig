<article{{ attributes.defaults({class: 'display-card display-card--with-logo'}) }}>
    <div class="display-card__logo">
        {% if this.logoUrl %}<img src="{{ this.logoUrl }}" alt="{{ card.logo.alt }}">{% endif %}
    </div>
    <div class="display-card__body"><h3 class="display-card__title">{{ card.title }}</h3><p class="display-card__text">{{ card.text }}</p></div>
    {% if card.cta and card.cta.label %}<twig:Front:Button :cta="card.cta" variant="secondary" class="display-card__cta" />{% endif %}
</article>
