{% set row_prototype %}{% include 'components/form/_breadcrumb_row.html.twig' with {row: field.vars.prototype} only %}{% endset %}

<fieldset
    class="key-value-collection"
    data-controller="form-collection"
    data-form-collection-index-value="{{ field|length }}"
    data-form-collection-prototype-value="{{ row_prototype|e('html_attr') }}"
>
    <legend>{{ field.vars.label }}</legend>
    {{ form_errors(field) }}
    <ul data-form-collection-target="collectionContainer">
        {% for row in field %}
            {% include 'components/form/_breadcrumb_row.html.twig' with {row: row} only %}
        {% endfor %}
    </ul>
    <twig:Admin:Button variant="outline" label="Ajouter une page parente" data-action="form-collection#addCollectionElement" />
</fieldset>

{# The collection is rendered manually above; prevent form_end() from rendering it again. #}
{% do field.setRendered %}
